# tip
auto-update-channel = tip

# Font
font-family = HackNF-Regular
font-size = 11

# Color
foreground = #DCDCDC
background = #11242B
cursor-color = #DCDCDC
cursor-text = #11242B
selection-background = #626880
selection-foreground = #c6d0f5

window-colorspace = srgb

# ANSI 16 colors (index 0-15)
palette = 0=#14191e
palette = 1=#b43c29
palette = 2=#00c200
palette = 3=#c7c400
palette = 4=#2743c7
palette = 5=#bf3fbd
palette = 6=#00c5c7
palette = 7=#c7c7c7
palette = 8=#676767
palette = 9=#dc7974
palette = 10=#57e690
palette = 11=#ece100
palette = 12=#a6aaf1
palette = 13=#e07de0
palette = 14=#5ffdff
palette = 15=#feffff

# Cmd + 矢印キー で分割した画面を「移動」
keybind = cmd+left=goto_split:left
keybind = cmd+right=goto_split:right
keybind = cmd+up=goto_split:top
keybind = cmd+down=goto_split:bottom

